@page
@model IcarryVendor.Web.Pages.Products.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "商品列表 " + Model.Heading;
    static string Money(decimal value) => value.ToString("#,0.##", CultureInfo.InvariantCulture);
    static string Signed(decimal value) => value > 0 ? "+" + Money(value) : value < 0 ? Money(value) : "";
    static string Enc(string? value) => System.Net.WebUtility.HtmlEncode(value ?? "");
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">
            商品列表
            <small>@Model.Heading <span class="badge">@Model.Hint</span></small>
        </h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="alert alert-info">
            新增、編輯、下架、停售、複製商品與庫存調整仍在改寫中，目前請到 icarry-newvendor 操作。
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover product-table">
                <thead>
                    <tr>
                        <th>品名／內容量／狀態</th>
                        <th>分類</th>
                        <th class="text-right">庫存 <sup class="label label-info" title="當商品低於安全庫存時會發送通知">?</sup></th>
                        <th class="text-right">單價</th>
                        <th class="text-right">行郵稅種類</th>
                        <th class="text-right">服務費(%)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Result.Items.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted">沒有符合條件的商品。</td></tr>
                    }
                    @foreach (var p in Model.Result.Items)
                    {
                        // Bootstrap renders these tooltips as HTML (data-html), so database text is encoded first.
                        var taxTip = p.ParcelTax is { } tax
                            ? $"品名及規格：{Enc(tax.Name)}<br />單位：{Enc(tax.UnitName)}<br />稅率：{Enc(tax.Tax)}<hr />試算：{tax.Estimate(p.Price)?.ToString("0.##", CultureInfo.InvariantCulture)}元"
                            : "";
                        var feeTip = string.Join("<br />", p.ServiceFees.Select(f => $"{Enc(f.Platform)}：{Money(f.BasePercent)}{Signed(f.Adjustment)}% ≈ {Money(f.Amount)}元"));
                        <tr>
                            <td>
                                @p.Name<br />
                                @if (!string.IsNullOrEmpty(p.ServingSize))
                                {
                                    <small class="badge">@p.ServingSize</small>
                                }
                                <h4><span class="label @ProductStatus.LabelClass(p.Status)">@ProductStatus.Label(p.Status)</span></h4>
                            </td>
                            <td>@p.CategoryName</td>
                            <td class="text-right">
                                <table class="table table-condensed model-table">
                                    <thead>
                                        <tr>
                                            <th>@(string.IsNullOrEmpty(p.ModelName) ? "規格" : p.ModelName)</th>
                                            <th>貨號</th>
                                            <th class="text-right">庫存</th>
                                            <th class="text-right">安全庫存</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in p.Models)
                                        {
                                            <tr>
                                                <td class="text-left">@m.Name</td>
                                                <td class="text-left">@m.Sku</td>
                                                <td class="text-right @(m.Quantity <= m.SafeQuantity ? "low-stock" : "")">@m.Quantity</td>
                                                <td class="text-right">@m.SafeQuantity</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </td>
                            <td class="text-right">@Money(p.Price)</td>
                            <td class="text-right info" data-toggle="tooltip" data-html="true" data-container="body" title="@taxTip">@p.ParcelTaxCode</td>
                            <td class="text-right info" data-toggle="tooltip" data-html="true" data-container="body" title="@feeTip">@Money(p.ServiceFeePercent)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="clearfix" aria-label="分頁">
            <h3 class="pull-left"><span class="label label-default">總筆數：@Model.Result.Total</span></h3>
            @if (Model.Result.PageCount > 1)
            {
                <ul class="pagination pull-right">
                    @for (var i = 1; i <= Model.Result.PageCount; i++)
                    {
                        <li class="@(i == Model.Result.Page ? "active" : "")">
                            <a asp-page="/Products/Index" asp-all-route-data="@ToRouteData(Model.PageRoute(i))">@i</a>
                        </li>
                    }
                </ul>
            }
        </nav>
    </div>
</div>

@functions {
    private static Dictionary<string, string> ToRouteData(object route) =>
        new Microsoft.AspNetCore.Routing.RouteValueDictionary(route)
            .Where(kv => kv.Value is not null)
            .ToDictionary(kv => kv.Key, kv => Convert.ToString(kv.Value, System.Globalization.CultureInfo.InvariantCulture)!);
}
