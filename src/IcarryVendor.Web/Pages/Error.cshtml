@page
@model ErrorModel
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "系統錯誤";
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header text-danger">系統發生錯誤</h1>
        <p>處理您的要求時發生錯誤，請稍後再試。若問題持續發生，請聯繫 iCarry LINE 群組。</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>錯誤代碼：</strong> <code>@Model.RequestId</code></p>
        }
    </div>
</div>
